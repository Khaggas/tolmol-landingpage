{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tolmol-landing",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-03-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tolmol-waitlist",
			"database_id": "ed9b6a9c-ea8a-4b04-af24-aa9af58628fb",
			"migrations_dir": "migrations"
		},
	]
}