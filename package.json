{
  "name": "tolmol-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "build:ci": "wrangler d1 migrations apply tolmol-waitlist --remote && opennextjs-cloudflare build",
    "deploy:ci": "wrangler d1 migrations apply tolmol-waitlist --remote && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "d1:apply:local": "wrangler d1 migrations apply tolmol-waitlist --local",
    "d1:apply:remote": "wrangler d1 migrations apply tolmol-waitlist --remote"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@opennextjs/cloudflare": "^1.19.11",
    "framer-motion": "^12.12.1",
    "gsap": "^3.13.0",
    "lenis": "^1.3.23",
    "lucide-react": "^0.511.0",
    "next": "^15.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260522.1",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "wrangler": "^4.94.0"
  }
}
